##########  plot Hi-C contact map

# clean working env
rm(list = ls(all.names = T))
gc()

# load packages
library(data.table)
library(dplyr)
library(readr)
library(ggplot2)

###  set paths
tsv <- '/home/yshin/Gloydius_ussuriensis_genome_assembly/outputs/tables/Gloydius_wholeassembly_1000000bp_raw.tsv'
assembly <- 'D:/Softwares/Juicebox/G_ussuriensis_Chromo/Gloydius_ussuriensis_AMNH_21010_curated_scaffold11_split_JBAT.assembly'


###  resolution used during juicer_tools dump
res <- 1000000


###  read dumped Hi-C matrix
hic <- fread(tsv, header = F)
head(hic)

# spit out error if the file format is different from the expected format
if (ncol(hic) < 3) {
  stop("Expected at least 3 columns in TSV: bin1, bin2, count")
}

# set colnames
hic <- hic[, 1:3]
setnames(hic, c('bin1', 'bin2', 'count'))

hic[, bin1 := as.numeric(bin1)]
hic[, bin2 := as.numeric(bin2)]
hic[, count := as.numeric(count)]

hic[, x := bin1 / res]
hic[, y := bin2 / res]
hic[, log_count := log10(count + 1)]

# mirror the matrix so both triangles are shown
hic_mirror <- copy(hic)
hic_mirror[, `:=`(x = y, y = x)]

hic_plot <- rbindlist(list(hic[, .(x, y, log_count)], hic_mirror[, .(x, y, log_count)]), use.names = T)


### parse .assembly file
boundary_df <- data.frame(boundary = numeric(0))
tick_df <- data.frame(pos = numeric(0), label = character(0))
box_df <- data.frame(start = numeric(0), end = numeric(0), label = character(0))

if (file.exists(assembly) && file.info(assembly)$size > 0) {
  asm_lines <- readLines(assembly, warn = F)
  asm_lines <- trimws(asm_lines)
  asm_lines <- asm_lines[nzchar(asm_lines)]
  
  header_lines <- asm_lines[grepl('^>', asm_lines)]
  group_lines  <- asm_lines[!grepl('^>', asm_lines)]
  
  # map: numeric contig ID -> contig length
  id_to_len <- numeric(0)
  
  for (ln in header_lines) {
    parts <- strsplit(sub('^>', '', ln), '\\s+')[[1]]
    if (length(parts) >= 3) {
      contig_id <- suppressWarnings(as.integer(parts[2]))
      contig_len <- suppressWarnings(as.numeric(parts[3]))
      if (!is.na(contig_id) && !is.na(contig_len)) {
        id_to_len[as.character(contig_id)] <- contig_len
      }
    }
  }
  
  # each non-header line is one assembly group, with signed contig IDs
  groups <- list()
  for (ln in group_lines) {
    vals <- suppressWarnings(as.integer(strsplit(ln, '\\s+')[[1]]))
    vals <- vals[!is.na(vals)]
    if (length(vals) > 0) {
      groups[[length(groups) + 1]] <- vals
    }
  }
  
  if (length(groups) > 0 && length(id_to_len) > 0) {
    group_lengths <- vapply(
      groups,
      function(g) sum(id_to_len[as.character(abs(g))], na.rm = T),
      numeric(1)
    )
    
    # keep only groups with nonzero length
    keep <- group_lengths > 0
    group_lengths <- group_lengths[keep]
    
    if (length(group_lengths) > 0) {
      group_ends_bp <- cumsum(group_lengths)
      group_starts_bp <- c(0, head(group_ends_bp, -1))
      group_mid_bp <- (group_starts_bp + group_ends_bp) / 2
      
      boundary_df <- data.frame(
        boundary = group_ends_bp / res
      )
      
      tick_df <- data.frame(
        pos = group_mid_bp / res,
        label = as.character(seq_along(group_lengths))
      )
      
      # boxes around diagonal assembly groups
      box_df <- data.frame(
        start = group_starts_bp / res,
        end = group_ends_bp / res,
        label = as.character(seq_along(group_lengths))
      )
    }
  }
}


### build plot
p <- ggplot(hic_plot, aes(x = x, y = y, fill = log_count)) +
  geom_raster() +
  coord_fixed(expand = F) +
  scale_y_reverse() +
  scale_fill_viridis_c(
    name = expression('log'[10]*'[Contacts + 1]'), 
    option = 'inferno',
    direction = -1
  ) +
  theme_classic() +
  theme(
    axis.title = element_blank(),
    axis.text.x = element_text(size = 14),
    axis.text.y = element_text(size = 14),
    axis.ticks = element_line(color = 'black'),
    axis.ticks.length = unit(0.3, 'cm'),
    legend.position = 'top',
    legend.title = element_text(size = 14),
    legend.text = element_text(size = 12)
  )

# add boxes only around diagonal clusters
if (nrow(box_df) > 0) {
  p <- p + geom_rect(data = box_df, aes(xmin = start, xmax = end, ymin = start, ymax = end), 
                     inherit.aes = F,fill = NA, color = 'grey20', linewidth = 1)
  }

print(p)


# save plot
ggsave('/home/yshin/Gloydius_ussuriensis_genome_assembly/R/Rplots/HiC_contact_map.png', p, width = 6, height = 6, dpi = 800)

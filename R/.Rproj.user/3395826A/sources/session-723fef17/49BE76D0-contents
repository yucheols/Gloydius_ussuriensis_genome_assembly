# Step 9 records annotation evidence, not a core whitelist
# Reference keyword annotations and Naja homolog assignments are provisional

naja_svmp <- c('006949', '006952', '006954', '006955', '006956', '006957')
naja_pla2 <- '006365'

# Known Naja anchors from Step 7B protein-homology review
naja_anchor_ids <- c('006948' = 'STC1', '006950' = 'ADAM-like', '006958' = 'NEFM', '006959' = 'NEFL', '006360' = 'OTUD3', '006356' = 'MUL1', '006373' = 'VWA5B1')
anchor_symbols <- list(SVMP = c('STC1', 'NEFM', 'NEFL', 'ADAM28', 'ADAM-like'), PLA2 = c('OTUD3', 'MUL1', 'VWA5B1'))

# Optional manually validated gene-to-anchor mappings
anchor_file <- file.path(datadir, 'curated_flanking_anchors.tsv')
anchor_map <- if (file.exists(anchor_file)) read_table(anchor_file) else tibble(species = character(), family = character(), gene_id = character(), anchor_symbol = character())

if (!all(c('species', 'family', 'gene_id', 'anchor_symbol') %in% names(anchor_map))) stop('curated_flanking_anchors.tsv requires species,family,gene_id,anchor_symbol.')
if (anyDuplicated(anchor_map[c('species', 'family', 'gene_id')])) stop('Duplicate curated flanking anchor assignments.')

# Optional curated toxin gene whitelist
curated_map <- if (file.exists(curated_file)) read_table(curated_file) else tibble(species = character(), family = character(), gene_id = character())

if (!all(c('species', 'family', 'gene_id') %in% names(curated_map))) stop('curated_toxin_gene_ids.tsv requires species,family,gene_id.')
if (TOXIN_MODE == 'curated_only' && !nrow(curated_map)) stop('TOXIN_MODE=curated_only requires curated_toxin_gene_ids.tsv with validated IDs.')

# Identify anchors using curated mappings, Naja homology, or annotation names
identify_anchor <- function(i) {
  
  g <- genes[i, ]
  sym <- NA_character_
  
  manual <- anchor_map %>%
    filter(species == g$species, family == g$family, gene_id == g$gene_id)
  
  if (nrow(manual)) {
    
    sym <- manual$anchor_symbol[1]
    
  } else {
    
    code <- str_extract(g$gene_id, '006[0-9]{3}')
    
    if (g$species == 'Naja_naja' && !is.na(code) && code %in% names(naja_anchor_ids)) {
      
      sym <- unname(naja_anchor_ids[code])
      
    } else {
      
      cols <- intersect(c('gene_id', 'functional_hint', 'manual_category', 'annotation_hint', 'review_notes'), names(g))
      annotation <- toupper(paste(na.omit(unlist(g[1, cols], use.names = F)), collapse = ' '))
      
      if (g$family == 'SVMP') {
        
        if (grepl('(?<![A-Z0-9])STC1(?![A-Z0-9])', annotation, perl = T)) {
          
          sym <- 'STC1'
          
        } else if (grepl('(?<![A-Z0-9])NEFM(?![A-Z0-9])|NEUROFILAMENT[^;]*MEDIUM', annotation, perl = T)) {
          
          sym <- 'NEFM'
          
        } else if (grepl('(?<![A-Z0-9])NEFL(?![A-Z0-9])|NEUROFILAMENT[^;]*LIGHT', annotation, perl = T)) {
          
          sym <- 'NEFL'
          
        } else if (grepl('ADAM[- ]?28|ADAM METALLOPEPTIDASE[^;]*28', annotation, perl = T)) {
          
          sym <- 'ADAM28'
          
        } else if (g$evidence_role == 'related_nonvenom_or_uncertain' && grepl('(?<![A-Z0-9])ADAM(?![A-Z0-9])', annotation, perl = T)) {
          
          sym <- 'ADAM-like'
          
        }
        
      } else if (g$family == 'PLA2') {
        
        for (a in anchor_symbols[['PLA2']]) {
          
          if (grepl(paste0('(?<![A-Z0-9])', a, '(?![A-Z0-9])'), annotation, perl = T)) {
            sym <- a
            break
          }
        }
      }
    }
  }
  
  if (!is.na(sym) && !(sym %in% anchor_symbols[[g$family]])) stop('Unexpected anchor assignment for ', g$gene_id, ': ', sym)
  
  sym
}

genes$anchor_symbol <- vapply(seq_len(nrow(genes)), identify_anchor, character(1))

# Correct Cerastes gene assignments from the Step 7 inventory
# ADAM is an ADAM-family model, not yet verified as ADAM28
genes$anchor_symbol[genes$species == 'Cerastes_gasperettii' & genes$family == 'SVMP' & genes$gene_id == 'ADAM'] <- 'ADAM-like'
genes$anchor_symbol[genes$species == 'Cerastes_gasperettii' & genes$family == 'SVMP' & genes$gene_id == 'gene-24098'] <- 'STC1'

genes$naja_code <- str_extract(genes$gene_id, '006[0-9]{3}')

# Classify toxin-family candidates
genes <- genes %>%
  mutate(toxin_evidence = case_when(species == 'Gloydius_ussuriensis' & evidence_role == 'ToxCodAn_candidate' ~ 'Gloydius ToxCodAn candidate', species %in% c('Cerastes_gasperettii', 'Crotalus_adamanteus') & evidence_role == 'toxin_family_keyword_candidate' ~ 'Reference toxin-family annotation', SHOW_PROVISIONAL_NAJA & species == 'Naja_naja' & family == 'SVMP' & naja_code %in% naja_svmp ~ 'Naja protein-supported homolog (provisional)', SHOW_PROVISIONAL_NAJA & species == 'Naja_naja' & family == 'PLA2' & naja_code %in% naja_pla2 ~ 'Naja protein-supported homolog (provisional)', TRUE ~ NA_character_), toxin_evidence = if_else(species == 'Gloydius_ussuriensis' & ((family == 'SVMP' & gene_id %in% c('SVMP-6')) | (family == 'PLA2' & gene_id %in% c('PLA2-1', 'PLA2I-like-1'))), NA_character_, toxin_evidence), curated_id = paste(species, family, gene_id, sep = '|'), on_curated_list = curated_id %in% paste(curated_map$species, curated_map$family, curated_map$gene_id, sep = '|'))

# Save candidate review table before curated filtering
write_tsv(genes %>% filter(!is.na(toxin_evidence)) %>% select(species, family, gene_id, toxin_evidence, on_curated_list, chr, start, end, strand), file.path(outdir, 'toxin_model_review.tsv'))

if (TOXIN_MODE == 'curated_only') {
  

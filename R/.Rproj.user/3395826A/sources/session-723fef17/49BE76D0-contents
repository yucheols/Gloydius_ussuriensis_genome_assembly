# ============================================================
#
# SVMP comparative microsynteny
# G. ussuriensis, C. adamanteus, C. gasperettii, N. naja
#
# ============================================================

# clean workspace
rm(list = ls(all.names = T))
gc()

# load packages
library(ggplot2)
library(gggenes)
library(dplyr)
library(readr)
library(stringr)

# ------------------------------------------------------------
# 1. directories and plotting options
# ------------------------------------------------------------

root <- '//wsl.localhost/Ubuntu/home/yshin/Gloydius_ussuriensis_genome_assembly'
if (!dir.exists(root)) root <- '/home/yshin/Gloydius_ussuriensis_genome_assembly'

datadir <- file.path(root, 'R', 'Rdata', 'toxin_microsynteny')
outdir <- file.path(root, 'R', 'Rplots')
dir.create(outdir, recursive = T, showWarnings = F)

interval_file <- file.path(datadir, 'anchor_bounded_regions.tsv')
gene_file <- file.path(datadir, 'comparative_all_gene_models_in_regions.tsv')

for (f in c(interval_file, gene_file)) {
  if (!file.exists(f)) stop('Missing input file: ', f)
}

FLIP_SPECIES <- c('Gloydius_ussuriensis', 'Naja_naja')

species_order <- c('Gloydius_ussuriensis', 'Crotalus_adamanteus', 'Cerastes_gasperettii', 'Naja_naja')
species_labels <- c('G. ussuriensis', 'C. adamanteus', 'C. gasperettii', 'N. naja')
names(species_labels) <- species_order

colors <- c('Flanking genes' = '#9FA6AD', 'SVMPs' = '#168A72', 'ADAM' = '#8E629C')

# ------------------------------------------------------------
# 2. import genomic intervals and gene catalog
# ------------------------------------------------------------

read_table <- function(path) {
  read_tsv(path, col_types = cols(.default = col_character()), show_col_types = F, progress = F)
}

intervals <- read_table(interval_file)
genes <- read_table(gene_file)

required <- list(intervals = c('family', 'species', 'chromosome', 'start', 'end'), genes = c('family', 'species', 'chr', 'gene_id', 'start', 'end', 'strand', 'plot_role', 'plot_include', 'anchor_symbol'))

for (nm in names(required)) {
  missing <- setdiff(required[[nm]], names(get(nm)))
  if (length(missing)) stop(nm, ' missing columns: ', paste(missing, collapse = ', '))
}

intervals <- intervals %>%
  filter(family == 'SVMP', species %in% species_order) %>%
  mutate(start = as.numeric(start), end = as.numeric(end), length_bp = end - start + 1, flip = species %in% FLIP_SPECIES)

if (nrow(intervals) != 4) stop('Expected four SVMP interval entries.')
if (anyDuplicated(intervals[c('family', 'species')])) stop('Duplicated SVMP interval entry.')
if (any(is.na(intervals$length_bp) | intervals$length_bp <= 0)) stop('Invalid SVMP interval coordinates.')

genes <- genes %>%
  filter(family == 'SVMP', species %in% species_order, plot_include == '1') %>%
  mutate(start = as.numeric(start), end = as.numeric(end)) %>%
  left_join(intervals %>% select(family, species, interval_chr = chromosome, interval_start = start, interval_end = end, length_bp, flip), by = c('family', 'species'))

if (any(is.na(genes$interval_start))) stop('Some gene records lack an SVMP interval.')
if (any(genes$chr != genes$interval_chr)) stop('Gene and interval chromosomes disagree.')

genes <- genes %>%
  filter(end >= interval_start, start <= interval_end) %>%
  mutate(local_start = pmax(start, interval_start) - interval_start + 1, local_end = pmin(end, interval_end) - interval_start + 1, plot_start = if_else(flip, length_bp - local_end + 1, local_start), plot_end = if_else(flip, length_bp - local_start + 1, local_end), forward = if_else(flip, strand == '-', strand == '+'))

# ------------------------------------------------------------
# 3. classify plotted genes
# ------------------------------------------------------------

anchor_roles <- c('conserved_anchor_candidate', 'provisional_VWA5B1_anchor_group')

genes <- genes %>%
  mutate(plot_class = case_when(plot_role %in% anchor_roles & anchor_symbol %in% c('NEFL', 'NEFM', 'STC1') ~ 'Flanking genes', plot_role == 'unannotated_anchor_candidate' ~ 'ADAM', plot_role %in% anchor_roles & anchor_symbol %in% c('ADAM', 'ADAM-like', 'ADAM28') ~ 'ADAM', plot_role %in% c('putative_venom_toxin', 'SVMP_like_candidate') ~ 'SVMPs', TRUE ~ 'Other annotated gene'),
         anchor_label = case_when(plot_class == 'Flanking genes' & anchor_symbol %in% c('NEFL', 'NEFM', 'STC1') ~ anchor_symbol, plot_class == 'ADAM' ~ 'ADAM', TRUE ~ NA_character_))

# ------------------------------------------------------------
# 4. replace the Gloydius dashed ADAM region with its
#    overlapping gene arrow
# ------------------------------------------------------------

adam_region <- genes %>%
  filter(species == 'Gloydius_ussuriensis', plot_role == 'unannotated_anchor_candidate')

if (nrow(adam_region) != 1) stop('Expected exactly one Gloydius provisional ADAM interval.')

adam_matches <- genes %>%
  filter(species == 'Gloydius_ussuriensis', plot_role != 'unannotated_anchor_candidate', chr == adam_region$chr[1], start <= adam_region$end[1], end >= adam_region$start[1]) %>%
  mutate(overlap_bp = pmin(end, adam_region$end[1]) - pmax(start, adam_region$start[1]) + 1, distance = abs((start + end) / 2 - (adam_region$start[1] + adam_region$end[1]) / 2)) %>%
  arrange(desc(overlap_bp), distance)

if (!nrow(adam_matches)) stop('No plotted Gloydius gene arrow overlaps the provisional ADAM interval.')

adam_gene <- adam_matches[1, ]

adam_index <- which(genes$species == 'Gloydius_ussuriensis' & genes$chr == adam_gene$chr & genes$gene_id == adam_gene$gene_id & genes$start == adam_gene$start & genes$end == adam_gene$end & genes$plot_role != 'unannotated_anchor_candidate')

if (length(adam_index) != 1) stop('Could not uniquely identify the overlapping Gloydius gene arrow.')

cat('Gloydius ADAM display arrow:', genes$gene_id[adam_index], '| original classification:', genes$plot_class[adam_index], '| overlap:', adam_gene$overlap_bp, 'bp\n')

genes$plot_class[adam_index] <- 'ADAM'
genes$anchor_label[adam_index] <- 'ADAM'

genes <- genes %>%
  filter(!(species == 'Gloydius_ussuriensis' & plot_role == 'unannotated_anchor_candidate'))

# ------------------------------------------------------------
# 5. remove non-plotted classes
# ------------------------------------------------------------

genes <- genes %>%
  filter(plot_class != 'Other annotated gene')

if (!all(genes$plot_class %in% names(colors))) {
  stop('Missing plot colors for: ', paste(setdiff(unique(genes$plot_class), names(colors)), collapse = ', '))
}

# ------------------------------------------------------------
# 6. collapse overlapping Gloydius toxin candidates
# ------------------------------------------------------------

collapse_overlapping_gloydius <- function(df) {
  
  tox <- df %>%
    filter(species == 'Gloydius_ussuriensis', plot_class == 'SVMPs') %>%
    arrange(start, end)
  
  if (nrow(tox) <= 1) return(df)
  
  cluster_id <- integer(nrow(tox))
  cluster_id[1] <- 1
  current_cluster <- 1
  current_end <- tox$end[1]
  
  for (i in 2:nrow(tox)) {
    if (tox$start[i] <= current_end) {
      cluster_id[i] <- current_cluster
      current_end <- max(current_end, tox$end[i])
    } else {
      current_cluster <- current_cluster + 1
      cluster_id[i] <- current_cluster
      current_end <- tox$end[i]
    }
  }
  
  tox$cluster_id <- cluster_id
  
  keep_ids <- tox %>%
    mutate(model_width = end - start + 1) %>%
    group_by(cluster_id) %>%
    slice_max(order_by = model_width, n = 1, with_ties = F) %>%
    ungroup() %>%
    pull(gene_id)
  
  df %>%
    filter(!(species == 'Gloydius_ussuriensis' & plot_class == 'SVMPs' & !(gene_id %in% keep_ids)))
}

genes <- collapse_overlapping_gloydius(genes)

# ------------------------------------------------------------
# 7. align species by their flanking regions
# ------------------------------------------------------------

left_flank <- genes %>%
  filter(plot_class == 'Flanking genes', anchor_symbol %in% c('NEFM', 'NEFL')) %>%
  group_by(species) %>%
  summarise(left_anchor = mean((plot_start + plot_end) / 2), left_genes = paste(sort(unique(anchor_symbol)), collapse = '/'), .groups = 'drop')

right_flank <- genes %>%
  filter(plot_class == 'Flanking genes', anchor_symbol == 'STC1') %>%
  group_by(species) %>%
  summarise(right_anchor = mean((plot_start + plot_end) / 2), n_STC1 = n(), .groups = 'drop')

flanks <- tibble(species = species_order) %>%
  left_join(left_flank, by = 'species') %>%
  left_join(right_flank, by = 'species') %>%
  mutate(anchor_span = right_anchor - left_anchor)

if (any(is.na(flanks$left_anchor) | is.na(flanks$right_anchor))) stop('Missing NEFM/NEFL or STC1 flanking anchor for one or more species.')
if (any(flanks$n_STC1 != 1)) stop('Expected one STC1 anchor per species.')
if (any(flanks$anchor_span <= 0)) stop('Flanking anchors are not ordered left-to-right.')

genes <- genes %>%
  left_join(flanks %>% select(species, left_anchor, anchor_span), by = 'species') %>%
  mutate(plot_start_bp = plot_start, plot_end_bp = plot_end, plot_start = (plot_start_bp - left_anchor) / anchor_span, plot_end = (plot_end_bp - left_anchor) / anchor_span, center = (plot_start + plot_end) / 2)

intervals <- intervals %>%
  left_join(flanks %>% select(species, left_anchor, anchor_span), by = 'species') %>%
  mutate(track_start = (1 - left_anchor) / anchor_span, track_end = (length_bp - left_anchor) / anchor_span)

y_map <- c('Gloydius_ussuriensis' = 3.1, 'Crotalus_adamanteus' = 2.4, 'Cerastes_gasperettii' = 1.7, 'Naja_naja' = 1.0)

genes <- genes %>%
  mutate(y = unname(y_map[species]))

intervals <- intervals %>%
  mutate(y = unname(y_map[species]))

gene_models <- genes

cat('===== FLANKING REGION ALIGNMENT =====\n')
print(flanks, n = Inf)

# ------------------------------------------------------------
# 8. draw plot
# ------------------------------------------------------------

plot_theme <- theme_classic(base_size = 13) +
  theme(
    plot.title = element_text(face = 'bold', size = 18),
    plot.title.position = 'plot',
    axis.text.y = element_text(face = 'italic', size = 15),
    axis.ticks.y = element_blank(),
    axis.line.y = element_blank(),
    panel.grid = element_blank(),
    axis.line.x = element_blank(),
    axis.ticks.x = element_blank(),
    axis.text.x = element_blank(),
    axis.title.x = element_blank(),
    legend.position = 'bottom',
    legend.direction = 'horizontal',
    legend.text = element_text(size = 13),
    legend.title = element_blank(),
    legend.key.width = grid::unit(1.0, 'cm'),
    legend.key.height = grid::unit(0.75, 'cm'),
    legend.spacing.x = grid::unit(0.6, 'cm'),
    plot.margin = margin(10, 18, 8, 12)
  )

p <- ggplot() +
  geom_segment(data = intervals, aes(x = track_start, xend = track_end, y = y, yend = y), color = '#929BA3', linewidth = 1.5)

# ------------------------------------------------------------
# arrows with flush arrowheads and black outlines
# ------------------------------------------------------------

if (nrow(gene_models) > 0) {
  p <- p + gggenes::geom_gene_arrow(data = gene_models, aes(xmin = plot_start, xmax = plot_end, y = y, fill = plot_class, forward = forward), arrowhead_width = grid::unit(1.3, 'mm'), arrowhead_height = grid::unit(6.0, 'mm'), arrow_body_height = grid::unit(6.0, 'mm'), colour = 'black', linewidth = 0.7)
}

plot_range <- range(c(intervals$track_start, intervals$track_end, genes$plot_start, genes$plot_end), na.rm = T)

p <- p +
  scale_fill_manual(values = colors, breaks = c('Flanking genes', 'SVMPs', 'ADAM'), name = NULL) +
  scale_x_continuous(breaks = NULL, limits = c(min(-0.04, plot_range[1] - 0.02), max(1.04, plot_range[2] + 0.02)), expand = c(0, 0)) +
  scale_y_continuous(breaks = c(3.1, 2.4, 1.7, 1.0), labels = species_labels[species_order], limits = c(0.5, 3.6), expand = c(0, 0)) +
  labs(title = '(A)', x = NULL, y = NULL) +
  plot_theme +
  guides(fill = guide_legend(nrow = 1, byrow = T, title = NULL))

print(p)

# ------------------------------------------------------------
# 9. export outputs
# ------------------------------------------------------------

plot_prefix <- file.path(outdir, 'SVMP_gene_overview_revised')

ggsave(paste0(plot_prefix, '.png'), p, width = 14, height = 5.2, dpi = 300)
ggsave(paste0(plot_prefix, '.pdf'), p, width = 14, height = 5.2)

write_tsv(genes %>% select(family, species, chr, gene_id, start, end, strand, plot_role, plot_class, anchor_label, plot_start_bp, plot_end_bp, plot_start, plot_end, forward), file.path(outdir, 'SVMP_displayed_gene_models_revised.tsv'))

cat('===== SVMP PLOT SUMMARY =====\n')
print(genes %>% count(species, plot_class), n = Inf)

cat('Output plot:', paste0(plot_prefix, '.png'), '\n')
cat('Output table:', file.path(outdir, 'SVMP_displayed_gene_models_revised.tsv'), '\n')
cat('===== COMPLETE =====\n')

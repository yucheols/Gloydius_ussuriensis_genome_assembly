}

read_table <- function(path) {
  read_tsv(path, col_types = cols(.default = col_character()), show_col_types = F, progress = F)
}

intervals <- read_table(interval_file)
genes <- read_table(gene_file)

required <- list(intervals = c('family', 'species', 'chromosome', 'start', 'end'), genes = c('feature_id', 'family', 'species', 'chr', 'gene_id', 'start', 'end', 'strand', 'evidence_role'))

for (nm in names(required)) {
  missing <- setdiff(required[[nm]], names(get(nm)))
  if (length(missing)) stop(nm, ' missing columns: ', paste(missing, collapse = ', '))
}

intervals <- intervals %>%
  mutate(start = as.numeric(start), end = as.numeric(end), length_bp = end - start + 1, flip = (family == 'SVMP' & species %in% FLIP_SVMP) | (family == 'PLA2' & species %in% FLIP_PLA2)) %>%
  filter(family %in% family_order, species %in% species_order)

if (nrow(intervals) != 8) stop('Expected eight species-by-family intervals.')
if (anyDuplicated(intervals[c('family', 'species')])) stop('Duplicated interval entry.')

genes <- genes %>%
  mutate(start = as.numeric(start), end = as.numeric(end)) %>%
  filter(family %in% family_order, species %in% species_order) %>%
  left_join(intervals %>% select(family, species, interval_start = start, interval_end = end, length_bp, flip), by = c('family', 'species')) %>%
  filter(!is.na(interval_start), end >= interval_start, start <= interval_end) %>%
  mutate(local_start = pmax(start, interval_start) - interval_start + 1, local_end = pmin(end, interval_end) - interval_start + 1, plot_start = if_else(flip, length_bp - local_end + 1, local_start), plot_end = if_else(flip, length_bp - local_start + 1, local_end), forward = if_else(flip, strand == '-', strand == '+'), center = (plot_start + plot_end) / 2, y = match(species, rev(species_order)))


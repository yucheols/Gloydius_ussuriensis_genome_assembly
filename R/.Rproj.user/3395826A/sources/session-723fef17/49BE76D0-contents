# ------------------------------------------------------------

interval_file <- file.path(datadir, 'anchor_bounded_regions.tsv')
gene_file <- file.path(datadir, 'gene_feature_catalog.tsv')
curated_file <- file.path(datadir, 'curated_toxin_gene_ids.tsv')

for (f in c(interval_file, gene_file)) {

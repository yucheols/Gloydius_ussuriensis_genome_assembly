# Audit the annotation evidence
anchor_presence <- bind_rows(lapply(family_order, function(fam) { expand.grid(family = fam, species = species_order, anchor_symbol = anchor_symbols[[fam]], stringsAsFactors = F) })) %>%
  left_join(genes %>% filter(!is.na(anchor_symbol)) %>% group_by(family, species, anchor_symbol) %>% summarise(identified_models = n_distinct(gene_id), .groups = 'drop'), by = c('family', 'species', 'anchor_symbol')) %>%
  mutate(identified_models = if_else(is.na(identified_models), 0L, as.integer(identified_models)), status = if_else(identified_models > 0, 'identified_in_catalog', 'not_identified_in_catalog'))

write_tsv(anchor_presence, file.path(outdir, 'anchor_presence_by_species.tsv'))
write_tsv(genes %>% filter(!is.na(anchor_symbol)) %>% select(family, species, gene_id, anchor_symbol, evidence_role, chr, start, end, strand), file.path(outdir, 'identified_anchor_models.tsv'))

# Suppress duplicate Gloydius Funannotate arrows when they
# substantially overlap displayed ToxCodAn toxin models

for (fam in family_order) {
  
  tox <- genes %>%
    filter(family == fam, species == 'Gloydius_ussuriensis', !is.na(toxin_evidence), evidence_role == 'ToxCodAn_candidate')
  
  idx <- which(genes$family == fam & genes$species == 'Gloydius_ussuriensis' & genes$evidence_role != 'ToxCodAn_candidate' & !is.na(genes$plot_class))
  
  for (i in idx) {
    
    if (!nrow(tox)) next
    
    ov <- pmax(0, pmin(genes$end[i], tox$end) - pmax(genes$start[i], tox$start) + 1)
    shorter <- pmin(genes$end[i] - genes$start[i] + 1, tox$end - tox$start + 1)
    
    if (is.na(genes$anchor_symbol[i]) && any(ov / shorter >= 0.60)) {
      genes$plot_class[i] <- NA_character_
    }
  }
}

plot_genes <- genes %>% filter(!is.na(plot_class))

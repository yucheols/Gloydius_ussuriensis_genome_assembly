# ------------------------------------------------------------
# 4. draw gggenes plots with homologous flanking anchors
# ------------------------------------------------------------

draw_microsynteny <- function(fam) {
  
  tracks <- intervals %>%
    filter(family == fam) %>%
    mutate(y = match(species, rev(species_order)))
  
  g <- plot_genes %>% filter(family == fam)
  maxlen <- max(tracks$length_bp)
  
  p <- ggplot() +
    geom_segment(data = tracks, aes(x = 1, xend = length_bp, y = y, yend = y), color = '#929BA3', linewidth = 0.8)
  
  p <- p +
    gggenes::geom_gene_arrow(data = g, aes(xmin = plot_start, xmax = plot_end, y = y, fill = plot_class, forward = forward), arrowhead_width = grid::unit(1.8, 'mm'), arrowhead_height = grid::unit(3.3, 'mm'), arrow_body_height = grid::unit(2.7, 'mm'), colour = '#34404A', linewidth = 0.24) +
    scale_fill_manual(values = colors, breaks = intersect(names(colors), unique(g$plot_class)), name = 'Gene annotation / homolog') +
    scale_y_continuous(breaks = 4:1, labels = species_labels, limits = c(0.65, 4.45), expand = c(0, 0)) +
    scale_x_continuous(breaks = pretty(c(0, maxlen), n = 6), labels = function(x) format(round(x / ifelse(fam == 'SVMP', 1e6, 1e3), 2), trim = T, scientific = F), limits = c(0, maxlen * 1.06), expand = c(0, 0)) +
    labs(title = paste0(ifelse(fam == 'PLA2', 'PLA₂', 'SVMP'), ' | Toxin genes and conserved anchors'), subtitle = if (fam == 'SVMP') 'G. ussuriensis and N. naja reversed for visual comparison' else 'Reference interval orientations retained', x = paste0('Position within displayed interval (', ifelse(fam == 'SVMP', 'Mb', 'kb'), ')'), y = NULL) +
    theme_classic(base_size = 12) +
    theme(plot.title = element_text(face = 'bold', size = 14), plot.subtitle = element_text(size = 9, color = '#626A70'), axis.text.y = element_text(face = 'italic', size = 10), axis.ticks.y = element_blank(), axis.line.y = element_blank(), panel.grid.major.x = element_line(color = '#EEEEEE', linewidth = 0.3), legend.position = 'bottom', legend.text = element_text(size = 8), legend.key.size = grid::unit(0.35, 'cm'), plot.margin = margin(10, 18, 12, 12)) +
    guides(fill = guide_legend(nrow = 2, byrow = T))
  
  if (SHOW_ANCHOR_LABELS) {
    
    a <- g %>% filter(!is.na(anchor_symbol))
    
    if (nrow(a)) {
      p <- p + geom_text(data = a, aes(x = center, y = y + 0.17, label = anchor_symbol), size = 2.8, check_overlap = T)
    }
  }
  
  if (SHOW_TOXIN_LABELS) {
    
    a <- g %>% filter(is.na(anchor_symbol))
    
    if (nrow(a)) {
      p <- p + geom_text(data = a, aes(x = center, y = y + 0.18, label = gene_id), size = 2.2, angle = 45, hjust = 0, check_overlap = T)
    }
  }
  
  p
}


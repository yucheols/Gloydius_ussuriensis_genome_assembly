#
# Other ambiguous PLA2-related models remain separate.
# No missing flanking anchors are inferred.
genes <- genes %>%
mutate(
is_inhibitor_like = species == 'Gloydius_ussuriensis' & gene_id %in% c('PLA2-1', 'PLA2I-like-1'),
is_pla2g2f = str_to_upper(coalesce(anchor_symbol, '')) == 'PLA2G2F',
plot_class = case_when(
is_pla2g2f ~ 'PLA2G2F',
is_inhibitor_like ~ 'Other PLA2-related',
plot_role == 'ambiguous_anchor_or_venom_PLA2' ~ 'Other PLA2-related',
plot_role %in% anchor_roles & !is.na(anchor_symbol) & anchor_symbol != '' ~ 'Flanking genes',
plot_role == 'putative_venom_toxin' ~ 'PLA2s',
plot_role == 'PLA2_like_candidate' ~ 'PLA2s',
TRUE ~ 'Other annotated gene'
),
anchor_label = case_when(
is_pla2g2f ~ 'PLA2G2F',
is_inhibitor_like ~ 'PLA2I-like',
plot_role == 'ambiguous_anchor_or_venom_PLA2' ~ 'PLA2-like?',
plot_role %in% anchor_roles ~ anchor_symbol,
TRUE ~ NA_character_
)
)
# ------------------------------------------------------------
# 4. remove non-plotted classes
# ------------------------------------------------------------
genes <- genes %>%
filter(plot_class != 'Other annotated gene')
if (!all(genes$plot_class %in% names(colors))) {
stop('Missing plot colors for: ', paste(setdiff(unique(genes$plot_class), names(colors)), collapse = ', '))
}
if (!nrow(genes)) stop('No PLA2 genes selected for plotting.')
# Verify PLA2G2F classification
cat('===== PLA2G2F GENE MODELS =====\n')
pla2g2f_check <- genes %>%
filter(plot_class == 'PLA2G2F')
print(pla2g2f_check %>% select(species, gene_id, plot_role, anchor_symbol, start, end), n = Inf)
# Verify inhibitor-like candidate classification
inhibitor_check <- genes %>%
filter(is_inhibitor_like)
cat('===== GLOYDIUS PLA2 INHIBITOR-LIKE CHECK =====\n')
if (nrow(inhibitor_check)) {
print(inhibitor_check %>% select(species, gene_id, plot_class), n = Inf)
} else {
warning('PLA2-1 / PLA2I-like-1 was not identified among the included gene models. Check its gene_id in the input table.')
}
# ------------------------------------------------------------
# 5. audit PLA2 candidate models
# ------------------------------------------------------------
# Keep all distinct annotated toxin candidates.
# Unlike SVMP, PLA2 candidates are not automatically collapsed
# solely because their genomic intervals overlap.
pla2_candidates <- genes %>%
filter(plot_class == 'PLA2s') %>%
arrange(species, start, end)
cat('===== PLA2 CANDIDATE MODELS =====\n')
print(pla2_candidates %>% select(species, gene_id, chr, start, end, plot_role), n = Inf)
# Inspect overlapping toxin models without deleting them
overlap_check <- pla2_candidates %>%
group_by(species) %>%
arrange(start, end, .by_group = T) %>%
mutate(previous_max_end = lag(cummax(end)), overlaps_previous = !is.na(previous_max_end) & start <= previous_max_end) %>%
ungroup()
if (any(overlap_check$overlaps_previous)) {
cat('===== POTENTIALLY OVERLAPPING PLA2 MODELS =====\n')
print(overlap_check %>% filter(overlaps_previous) %>% select(species, gene_id, start, end), n = Inf)
}
# ------------------------------------------------------------
# 6. align species using relative genomic intervals
# ------------------------------------------------------------
# Unlike the SVMP region, conserved anchor pairs have not
# been identified for every species in the PLA2 region.
#
# Each extracted PLA2 interval is therefore scaled to 0-1.
# Internal spacing within each interval is retained
# proportionally.
#
# This is a relative-position display, not a shared bp scale.
genes <- genes %>%
mutate(plot_start_bp = plot_start, plot_end_bp = plot_end, plot_start = plot_start_bp / length_bp, plot_end = plot_end_bp / length_bp, center = (plot_start + plot_end) / 2)
intervals <- intervals %>%
mutate(track_start = 0, track_end = 1)
y_map <- c('Gloydius_ussuriensis' = 3.1, 'Crotalus_adamanteus' = 2.4, 'Cerastes_gasperettii' = 1.7, 'Naja_naja' = 1.0)
genes <- genes %>%
mutate(y = unname(y_map[species]))
intervals <- intervals %>%
mutate(y = unname(y_map[species]))
gene_models <- genes
cat('===== PLA2 REGION ALIGNMENT =====\n')
print(intervals %>% select(species, chromosome, start, end, length_bp, flip, track_start, track_end), n = Inf)
# ------------------------------------------------------------
# 7. audit identified flanking anchors
# ------------------------------------------------------------
expected_anchors <- c('OTUD3', 'MUL1', 'VWA5B1', 'PLA2G2F')
anchor_presence <- expand.grid(species = species_order, anchor_symbol = expected_anchors, stringsAsFactors = F) %>%
as_tibble() %>%
left_join(genes %>% filter(!is.na(anchor_symbol), anchor_symbol %in% expected_anchors, plot_role %in% anchor_roles) %>% count(species, anchor_symbol, name = 'identified_models'), by = c('species', 'anchor_symbol')) %>%
mutate(identified_models = coalesce(identified_models, 0L), status = if_else(identified_models > 0, 'identified', 'not_identified_in_catalog'))
cat('===== PLA2 FLANKING ANCHOR STATUS =====\n')
print(anchor_presence, n = Inf)
write_tsv(anchor_presence, file.path(outdir, 'PLA2_anchor_presence_revised.tsv'))
# ------------------------------------------------------------
# 8. draw plot
# ------------------------------------------------------------
plot_theme <- theme_classic(base_size = 13) +
theme(
plot.title = element_text(face = 'bold', size = 18),
plot.title.position = 'plot',
axis.text.y = element_text(face = 'italic', size = 15),
axis.ticks.y = element_blank(),
axis.line.y = element_blank(),
panel.grid = element_blank(),
axis.line.x = element_blank(),
axis.ticks.x = element_blank(),
axis.text.x = element_blank(),
axis.title.x = element_blank(),
legend.position = 'bottom',
legend.direction = 'horizontal',
legend.text = element_text(size = 13),
legend.title = element_blank(),
legend.key.width = grid::unit(1.0, 'cm'),
legend.key.height = grid::unit(0.75, 'cm'),
legend.spacing.x = grid::unit(0.6, 'cm'),
plot.margin = margin(10, 18, 8, 12)
)
# chromosome midlines
p <- ggplot() +
geom_segment(data = intervals, aes(x = track_start, xend = track_end, y = y, yend = y), color = '#929BA3', linewidth = 1.5)
# ------------------------------------------------------------
# arrows with flush arrowheads and black outlines
# ------------------------------------------------------------
if (nrow(gene_models) > 0) {
p <- p + gggenes::geom_gene_arrow(data = gene_models, aes(xmin = plot_start, xmax = plot_end, y = y, fill = plot_class, forward = forward), arrowhead_width = grid::unit(1.3, 'mm'), arrowhead_height = grid::unit(6.0, 'mm'), arrow_body_height = grid::unit(6.0, 'mm'), colour = 'black', linewidth = 0.7)
}
plot_range <- range(c(intervals$track_start, intervals$track_end, genes$plot_start, genes$plot_end), na.rm = T)
p <- p +
scale_fill_manual(values = colors, breaks = c('Flanking genes', 'PLA2s', 'PLA2G2F', 'Other PLA2-related'), name = NULL) +
scale_x_continuous(breaks = NULL, limits = c(min(-0.04, plot_range[1] - 0.02), max(1.04, plot_range[2] + 0.02)), expand = c(0, 0)) +
scale_y_continuous(breaks = c(3.1, 2.4, 1.7, 1.0), labels = species_labels[species_order], limits = c(0.5, 3.6), expand = c(0, 0)) +
labs(title = '(B)', x = NULL, y = NULL) +
plot_theme +
guides(fill = guide_legend(nrow = 1, byrow = T, title = NULL))
print(p)
# ------------------------------------------------------------
# 9. export outputs
# ------------------------------------------------------------
plot_prefix <- file.path(outdir, 'PLA2_gene_overview_revised')
ggsave(paste0(plot_prefix, '.png'), p, width = 14, height = 5.2, dpi = 300)
ggsave(paste0(plot_prefix, '.pdf'), p, width = 14, height = 5.2)
write_tsv(genes %>% select(family, species, chr, gene_id, start, end, strand, plot_role, plot_class, anchor_symbol, anchor_label, is_inhibitor_like, plot_start_bp, plot_end_bp, plot_start, plot_end, forward), file.path(outdir, 'PLA2_displayed_gene_models_revised.tsv'))
cat('===== PLA2 PLOT SUMMARY =====\n')
print(genes %>% count(species, plot_class), n = Inf)
cat('Output plot:', paste0(plot_prefix, '.png'), '\n')
cat('Output PDF:', paste0(plot_prefix, '.pdf'), '\n')
cat('Output table:', file.path(outdir, 'PLA2_displayed_gene_models_revised.tsv'), '\n')
cat('Anchor audit:', file.path(outdir, 'PLA2_anchor_presence_revised.tsv'), '\n')
cat('===== COMPLETE =====\n')
# ============================================================
#
# PLA2 comparative microsynteny
# Annotation audit before revising the figure
#
# ============================================================
# clean workspace
rm(list = ls(all.names = T))
gc()
# load packages
library(dplyr)
library(readr)
library(stringr)
library(tidyr)
# ------------------------------------------------------------
# 1. directories and input files
# ------------------------------------------------------------
root <- '//wsl.localhost/Ubuntu/home/yshin/Gloydius_ussuriensis_genome_assembly'
if (!dir.exists(root)) root <- '/home/yshin/Gloydius_ussuriensis_genome_assembly'
datadir <- file.path(root, 'R', 'Rdata', 'toxin_microsynteny')
outdir <- file.path(root, 'R', 'Rplots')
dir.create(outdir, recursive = T, showWarnings = F)
interval_file <- file.path(datadir, 'anchor_bounded_regions.tsv')
gene_file <- file.path(datadir, 'comparative_all_gene_models_in_regions.tsv')
feature_file <- file.path(datadir, 'gene_feature_catalog.tsv')
for (f in c(interval_file, gene_file)) {
if (!file.exists(f)) stop('Missing input file: ', f)
}
species_order <- c('Gloydius_ussuriensis', 'Crotalus_adamanteus', 'Cerastes_gasperettii', 'Naja_naja')
expected_anchors <- c('OTUD3', 'MUL1', 'VWA5B1', 'PLA2G2E', 'PLA2G2F')
# ------------------------------------------------------------
# 2. import data
# ------------------------------------------------------------
read_table <- function(path) {
read_tsv(path, col_types = cols(.default = col_character()), show_col_types = F, progress = F)
}
intervals <- read_table(interval_file)
genes <- read_table(gene_file)
required_intervals <- c('family', 'species', 'chromosome', 'start', 'end')
required_genes <- c('family', 'species', 'chr', 'gene_id', 'start', 'end', 'strand', 'plot_role', 'plot_include', 'anchor_symbol')
if (length(setdiff(required_intervals, names(intervals)))) stop('Missing interval columns: ', paste(setdiff(required_intervals, names(intervals)), collapse = ', '))
if (length(setdiff(required_genes, names(genes)))) stop('Missing gene columns: ', paste(setdiff(required_genes, names(genes)), collapse = ', '))
intervals <- intervals %>%
filter(family == 'PLA2', species %in% species_order) %>%
mutate(start = as.numeric(start), end = as.numeric(end), length_bp = end - start + 1)
if (nrow(intervals) != 4) stop('Expected four PLA2 genomic intervals.')
if (anyDuplicated(intervals[c('family', 'species')])) stop('Duplicated PLA2 genomic intervals.')
if (any(is.na(intervals$length_bp) | intervals$length_bp <= 0)) stop('Invalid interval coordinates.')
# ------------------------------------------------------------
# 3. combine available annotation fields
# ------------------------------------------------------------
# Search all available annotation descriptions rather than
# relying exclusively on the anchor_symbol field.
annotation_columns <- c('gene_id', 'anchor_symbol', 'plot_role', 'evidence_role', 'annotation_hint', 'functional_hint', 'manual_category', 'review_notes', 'product', 'description', 'gene_name', 'name')
add_annotation_text <- function(df) {
cols <- intersect(annotation_columns, names(df))
if (!length(cols)) {
df$annotation_text <- rep('', nrow(df))
return(df)
}
values <- lapply(df[cols], function(x) ifelse(is.na(x), '', as.character(x)))
df$annotation_text <- do.call(paste, c(values, list(sep = ' | ')))
df$annotation_text <- str_to_upper(df$annotation_text)
df
}
genes <- genes %>%
filter(family == 'PLA2', species %in% species_order) %>%
mutate(start = as.numeric(start), end = as.numeric(end)) %>%
add_annotation_text() %>%
left_join(intervals %>% select(family, species, interval_chr = chromosome, interval_start = start, interval_end = end), by = c('family', 'species'))
# ------------------------------------------------------------
# 4. reproduce current plotting eligibility
# ------------------------------------------------------------
anchor_roles <- c('conserved_anchor_candidate', 'provisional_VWA5B1_anchor_group')
genes <- genes %>%
mutate(
valid_coordinates = !is.na(start) & !is.na(end) & start <= end,
chromosome_matches = !is.na(chr) & !is.na(interval_chr) & chr == interval_chr,
overlaps_interval = valid_coordinates & !is.na(interval_start) & !is.na(interval_end) & end >= interval_start & start <= interval_end,
plot_flag = coalesce(plot_include, '') == '1',
is_inhibitor_like = species == 'Gloydius_ussuriensis' & gene_id %in% c('PLA2-1', 'PLA2I-like-1'),
is_pla2g2f = str_to_upper(coalesce(anchor_symbol, '')) == 'PLA2G2F',
plot_class = case_when(
is_pla2g2f ~ 'PLA2G2F',
is_inhibitor_like ~ 'Other PLA2-related',
plot_role == 'ambiguous_anchor_or_venom_PLA2' ~ 'Other PLA2-related',
plot_role %in% anchor_roles & !is.na(anchor_symbol) & anchor_symbol != '' ~ 'Flanking genes',
plot_role == 'putative_venom_toxin' ~ 'PLA2s',
plot_role == 'PLA2_like_candidate' ~ 'PLA2s',
TRUE ~ 'Other annotated gene'
),
displayed = plot_flag & chromosome_matches & overlaps_interval & plot_class != 'Other annotated gene',
display_reason = case_when(
!valid_coordinates ~ 'Invalid coordinates',
!chromosome_matches ~ 'Chromosome mismatch',
!overlaps_interval ~ 'Outside PLA2 interval',
!plot_flag ~ 'plot_include != 1',
plot_class == 'Other annotated gene' ~ 'Excluded classification',
TRUE ~ 'Displayed'
),
toxin_role = plot_role %in% c('putative_venom_toxin', 'PLA2_like_candidate'),
candidate_enzymatic = toxin_role & !is_inhibitor_like & !is_pla2g2f
)
# Save complete inventory before applying any plotting filters.
write_tsv(genes, file.path(outdir, 'PLA2_audit_all_gene_models.tsv'))
# ------------------------------------------------------------
# 5. candidate count audit
# ------------------------------------------------------------
count_summary <- genes %>%
group_by(species) %>%
summarise(
total_catalog_records = n(),
toxin_role_records = sum(toxin_role),
displayed_PLA2 = sum(displayed & plot_class == 'PLA2s'),
excluded_toxin_role_records = sum(toxin_role & !displayed),
displayed_PLA2G2F = sum(displayed & plot_class == 'PLA2G2F'),
.groups = 'drop'
) %>%
arrange(match(species, species_order))
cat('\n===== PLA2 CANDIDATE COUNT AUDIT =====\n')
print(count_summary, n = Inf, width = Inf)
write_tsv(count_summary, file.path(outdir, 'PLA2_audit_candidate_counts.tsv'))
# ------------------------------------------------------------
# 6. examine C. gasperettii and C. adamanteus
# ------------------------------------------------------------
# Include both plotted and excluded records.
# Do not assume the annotations represent confirmed toxin genes.
comparison_models <- genes %>%
filter(species %in% c('Cerastes_gasperettii', 'Crotalus_adamanteus')) %>%
arrange(species, start, end)
cat('\n===== CERASTES AND CROTALUS: ALL MODELS =====\n')
print(comparison_models %>% select(species, gene_id, chr, start, end, strand, plot_role, anchor_symbol, plot_include, plot_class, displayed, display_reason), n = Inf, width = Inf)
write_tsv(comparison_models, file.path(outdir, 'PLA2_audit_Cerastes_Crotalus_models.tsv'))
# Specifically list all models assigned a toxin-like role.
candidate_models <- genes %>%
filter(toxin_role | is_inhibitor_like | plot_role == 'ambiguous_anchor_or_venom_PLA2') %>%
arrange(species, start, end)
cat('\n===== ALL PLA2 TOXIN AND AMBIGUOUS CANDIDATES =====\n')
print(candidate_models %>% select(species, gene_id, start, end, plot_role, anchor_symbol, plot_include, plot_class, displayed), n = Inf, width = Inf)
write_tsv(candidate_models, file.path(outdir, 'PLA2_audit_toxin_candidates.tsv'))
# ------------------------------------------------------------
# 7. inspect overlapping toxin candidate models
# ------------------------------------------------------------
# Pairwise overlap analysis to identify potentially redundant
# gene models. Overlap alone is NOT evidence of redundancy.
find_overlaps <- function(df) {
df <- df %>%
filter(candidate_enzymatic, valid_coordinates, !is.na(chr)) %>%
arrange(start, end)
if (nrow(df) < 2) return(tibble())
pairs <- t(combn(seq_len(nrow(df)), 2))
results <- tibble(
species = df$species[pairs[, 1]],
chr_1 = df$chr[pairs[, 1]],
chr_2 = df$chr[pairs[, 2]],
gene_1 = df$gene_id[pairs[, 1]],
gene_2 = df$gene_id[pairs[, 2]],
start_1 = df$start[pairs[, 1]],
end_1 = df$end[pairs[, 1]],
start_2 = df$start[pairs[, 2]],
end_2 = df$end[pairs[, 2]]
) %>%
mutate(overlap_bp = if_else(chr_1 == chr_2, pmax(0, pmin(end_1, end_2) - pmax(start_1, start_2) + 1), 0),
identical_coordinates = chr_1 == chr_2 & start_1 == start_2 & end_1 == end_2) %>%
filter(overlap_bp > 0)
results
}
overlap_results <- bind_rows(lapply(split(genes, genes$species), find_overlaps))
cat('\n===== OVERLAPPING PLA2 CANDIDATES =====\n')
print(overlap_results, n = Inf, width = Inf)
write_tsv(overlap_results, file.path(outdir, 'PLA2_audit_overlapping_candidates.tsv'))
# ------------------------------------------------------------
# 8. identify repeated gene IDs
# ------------------------------------------------------------
duplicate_models <- genes %>%
count(species, gene_id, name = 'catalog_records') %>%
filter(catalog_records > 1)
cat('\n===== REPEATED GENE IDS =====\n')
print(duplicate_models, n = Inf)
write_tsv(duplicate_models, file.path(outdir, 'PLA2_audit_repeated_gene_ids.tsv'))
# ------------------------------------------------------------
# 9. search for conserved flanking genes
# ------------------------------------------------------------
# Search annotation fields for:
# OTUD3, MUL1, VWA5B1, PLA2G2E, PLA2G2F.
#
# A text match is a candidate annotation, not validated
# orthology or proof of conserved synteny.
anchor_patterns <- c(
OTUD3 = 'OTUD3',
MUL1 = 'MUL1',
VWA5B1 = 'VWA5B1',
PLA2G2E = 'PLA2[-_ ]?G2E',
PLA2G2F = 'PLA2[-_ ]?G2F'
)
anchor_hits <- bind_rows(lapply(names(anchor_patterns), function(a) {
genes %>%
filter(str_detect(annotation_text, anchor_patterns[[a]])) %>%
mutate(target_anchor = a)
}))
anchor_hits <- anchor_hits %>%
arrange(target_anchor, species, start)
cat('\n===== ANCHOR ANNOTATION HITS =====\n')
print(anchor_hits %>% select(target_anchor, species, gene_id, start, end, plot_role, anchor_symbol, plot_include, displayed), n = Inf, width = Inf)
write_tsv(anchor_hits, file.path(outdir, 'PLA2_audit_anchor_annotation_hits.tsv'))
anchor_presence <- expand_grid(species = species_order, target_anchor = expected_anchors) %>%
left_join(anchor_hits %>% group_by(species, target_anchor) %>% summarise(n_catalog_hits = n_distinct(gene_id), n_displayed_hits = n_distinct(gene_id[displayed]), .groups = 'drop'), by = c('species', 'target_anchor')) %>%
mutate(n_catalog_hits = replace_na(n_catalog_hits, 0L), n_displayed_hits = replace_na(n_displayed_hits, 0L), status = if_else(n_catalog_hits > 0, 'Annotation hit', 'Not identified in catalog'))
cat('\n===== ANCHOR PRESENCE MATRIX =====\n')
print(anchor_presence, n = Inf, width = Inf)
write_tsv(anchor_presence, file.path(outdir, 'PLA2_audit_anchor_presence.tsv'))
# ------------------------------------------------------------
# 10. optional audit of original feature catalog
# ------------------------------------------------------------
# gene_feature_catalog.tsv predates the final plot selection.
# It may contain candidate gene models omitted from the
# comparative plotting catalog.
if (file.exists(feature_file)) {
cat('\n===== CHECKING ORIGINAL GENE FEATURE CATALOG =====\n')
features <- read_table(feature_file)
feature_required <- c('family', 'species', 'chr', 'gene_id', 'start', 'end')
if (all(feature_required %in% names(features))) {
features <- features %>%
filter(family == 'PLA2', species %in% species_order) %>%
mutate(start = as.numeric(start), end = as.numeric(end)) %>%
add_annotation_text() %>%
left_join(intervals %>% select(species, interval_chr = chromosome, interval_start = start, interval_end = end), by = 'species') %>%
mutate(within_region = !is.na(start) & !is.na(end) & !is.na(interval_start) & !is.na(interval_end) & !is.na(chr) & chr == interval_chr & end >= interval_start & start <= interval_end) %>%
filter(within_region)
# Search original annotations for relevant candidates.
feature_hits <- features %>%
filter(str_detect(annotation_text, 'PLA2|PHOSPHOLIPASE|OTUD3|MUL1|VWA5B1'))
# Mark whether the original feature is found in the
# current plotting catalog by species, gene ID, and locus.
feature_hits <- feature_hits %>%
left_join(genes %>% distinct(species, chr, gene_id, start, end) %>% mutate(in_plot_catalog = T), by = c('species', 'chr', 'gene_id', 'start', 'end')) %>%
mutate(in_plot_catalog = replace_na(in_plot_catalog, F))
cat('\n===== ORIGINAL CATALOG: PLA2 / ANCHOR HITS =====\n')
print(feature_hits %>% select(species, gene_id, chr, start, end, in_plot_catalog, any_of(c('evidence_role', 'annotation_hint', 'functional_hint', 'manual_category'))), n = Inf, width = Inf)
write_tsv(feature_hits, file.path(outdir, 'PLA2_audit_original_feature_hits.tsv'))
} else {
warning('Optional gene_feature_catalog.tsv is missing required columns. Skipping original feature audit.')
}
} else {
cat('\nOptional gene_feature_catalog.tsv not found. Skipping original feature audit.\n')
}
# ------------------------------------------------------------
# 11. final diagnostic summary
# ------------------------------------------------------------
cat('\n============================================\n')
cat('PLA2 ANNOTATION AUDIT COMPLETE\n')
cat('============================================\n')
cat('\nCandidate counts:\n')
print(count_summary, n = Inf)
cat('\nAnchor presence:\n')
print(anchor_presence, n = Inf)
cat('\nOverlapping toxin-model pairs:', nrow(overlap_results), '\n')
cat('Repeated gene IDs:', nrow(duplicate_models), '\n')
cat('\nOutput directory:', outdir, '\n')
cat('No source annotation files were modified.\n')
cat('No gene models were reclassified or removed.\n')
cat('============================================\n')
# ============================================================
#
# PLA2 locus: inspect genes between OTUD3 and MUL1
#
# ============================================================
rm(list = ls(all.names = T))
gc()
library(dplyr)
library(readr)
library(stringr)
library(tidyr)
root <- '//wsl.localhost/Ubuntu/home/yshin/Gloydius_ussuriensis_genome_assembly'
if (!dir.exists(root)) root <- '/home/yshin/Gloydius_ussuriensis_genome_assembly'
datadir <- file.path(root, 'R', 'Rdata', 'toxin_microsynteny')
outdir <- file.path(root, 'R', 'Rplots')
dir.create(outdir, recursive = T, showWarnings = F)
gene_file <- file.path(datadir, 'comparative_all_gene_models_in_regions.tsv')
genes <- read_tsv(gene_file, col_types = cols(.default = col_character()), show_col_types = F) %>%
filter(family == 'PLA2') %>%
mutate(start = as.numeric(start), end = as.numeric(end), midpoint = (start + end) / 2)
# Extract unique displayed anchor models.
anchors <- genes %>%
filter(anchor_symbol %in% c('OTUD3', 'MUL1'), plot_include == '1') %>%
select(species, anchor_symbol, midpoint) %>%
pivot_wider(names_from = anchor_symbol, values_from = midpoint)
if (!all(c('OTUD3', 'MUL1') %in% names(anchors))) stop('Required anchors are missing.')
if (anyDuplicated(anchors$species)) stop('Multiple displayed OTUD3 or MUL1 candidates for a species.')
if (any(is.na(anchors$OTUD3) | is.na(anchors$MUL1))) stop('One or more species lack required anchor coordinates.')
# Find models located between the two anchors.
locus_genes <- genes %>%
left_join(anchors, by = 'species') %>%
filter(midpoint > pmin(OTUD3, MUL1), midpoint < pmax(OTUD3, MUL1)) %>%
mutate(distance_from_OTUD3 = if_else(OTUD3 < MUL1, midpoint - OTUD3, OTUD3 - midpoint), displayed = plot_include == '1' & plot_role != 'other_annotated_gene', candidate_group = case_when(anchor_symbol == 'PLA2G2F' ~ 'PLA2G2F candidate', anchor_symbol == 'PLA2G2E' ~ 'PLA2G2E candidate', plot_role == 'putative_venom_toxin' ~ 'Putative venom PLA2', plot_role == 'PLA2_like_candidate' ~ 'Provisional PLA2 homolog', plot_role == 'unresolved_family_homolog' ~ 'Unresolved family homolog', TRUE ~ 'Other model')) %>%
arrange(species, distance_from_OTUD3)
cat('\n===== PLA2 GENE ORDER: OTUD3 TO MUL1 =====\n')
print(locus_genes %>% select(species, gene_id, start, end, strand, plot_role, anchor_symbol, candidate_group, plot_include, distance_from_OTUD3), n = Inf, width = Inf)
write_tsv(locus_genes, file.path(outdir, 'PLA2_OTUD3_MUL1_gene_order.tsv'))
cat('\n===== SUMMARY =====\n')
print(locus_genes %>% count(species, candidate_group), n = Inf)
cat('\nOutput:', file.path(outdir, 'PLA2_OTUD3_MUL1_gene_order.tsv'), '\n')
# ============================================================
#
# PLA2 locus: inspect genes between OTUD3 and MUL1
#
# ============================================================
rm(list = ls(all.names = T))
gc()
library(dplyr)
library(readr)
library(stringr)
library(tidyr)
root <- '//wsl.localhost/Ubuntu/home/yshin/Gloydius_ussuriensis_genome_assembly'
if (!dir.exists(root)) root <- '/home/yshin/Gloydius_ussuriensis_genome_assembly'
datadir <- file.path(root, 'R', 'Rdata', 'toxin_microsynteny')
outdir <- file.path(root, 'R', 'Rplots')
dir.create(outdir, recursive = T, showWarnings = F)
gene_file <- file.path(datadir, 'comparative_all_gene_models_in_regions.tsv')
genes <- read_tsv(gene_file, col_types = cols(.default = col_character()), show_col_types = F) %>%
filter(family == 'PLA2') %>%
mutate(start = as.numeric(start), end = as.numeric(end), midpoint = (start + end) / 2)
# Extract unique displayed anchor models.
anchors <- genes %>%
filter(anchor_symbol %in% c('OTUD3', 'MUL1'), plot_include == '1') %>%
select(species, anchor_symbol, midpoint) %>%
pivot_wider(names_from = anchor_symbol, values_from = midpoint)
if (!all(c('OTUD3', 'MUL1') %in% names(anchors))) stop('Required anchors are missing.')
if (anyDuplicated(anchors$species)) stop('Multiple displayed OTUD3 or MUL1 candidates for a species.')
if (any(is.na(anchors$OTUD3) | is.na(anchors$MUL1))) stop('One or more species lack required anchor coordinates.')
# Find models located between the two anchors.
locus_genes <- genes %>%
left_join(anchors, by = 'species') %>%
filter(midpoint > pmin(OTUD3, MUL1), midpoint < pmax(OTUD3, MUL1)) %>%
mutate(distance_from_OTUD3 = if_else(OTUD3 < MUL1, midpoint - OTUD3, OTUD3 - midpoint), displayed = plot_include == '1' & plot_role != 'other_annotated_gene', candidate_group = case_when(anchor_symbol == 'PLA2G2F' ~ 'PLA2G2F candidate', anchor_symbol == 'PLA2G2E' ~ 'PLA2G2E candidate', plot_role == 'putative_venom_toxin' ~ 'Putative venom PLA2', plot_role == 'PLA2_like_candidate' ~ 'Provisional PLA2 homolog', plot_role == 'unresolved_family_homolog' ~ 'Unresolved family homolog', TRUE ~ 'Other model')) %>%
arrange(species, distance_from_OTUD3)
cat('\n===== PLA2 GENE ORDER: OTUD3 TO MUL1 =====\n')
print(locus_genes %>% select(species, gene_id, start, end, strand, plot_role, anchor_symbol, candidate_group, plot_include, distance_from_OTUD3), n = Inf, width = Inf)
write_tsv(locus_genes, file.path(outdir, 'PLA2_OTUD3_MUL1_gene_order.tsv'))
cat('\n===== SUMMARY =====\n')
print(locus_genes %>% count(species, candidate_group), n = Inf)
cat('\nOutput:', file.path(outdir, 'PLA2_OTUD3_MUL1_gene_order.tsv'), '\n')
library(dplyr)
library(readr)
root <- '//wsl.localhost/Ubuntu/home/yshin/Gloydius_ussuriensis_genome_assembly'
if (!dir.exists(root)) root <- '/home/yshin/Gloydius_ussuriensis_genome_assembly'
datadir <- file.path(root, 'R', 'Rdata', 'toxin_microsynteny')
genes <- read_tsv(file.path(datadir, 'comparative_all_gene_models_in_regions.tsv'), col_types = cols(.default = col_character()), show_col_types = F)
targets <- c('gene-23184', 'gene-NXF25_017765', 'gene-E2320_006364', 'FUN_018072')
candidate_review <- genes %>%
filter(family == 'PLA2', gene_id %in% targets) %>%
select(species, gene_id, start, end, strand, plot_role, plot_include, anchor_symbol, any_of(c('annotation_hint', 'functional_hint', 'manual_category', 'review_notes', 'description', 'product', 'evidence_role')))
print(candidate_review, n = Inf, width = Inf)
write_tsv(candidate_review, file.path(root, 'R', 'Rplots', 'PLA2_uncertain_model_review.tsv'))

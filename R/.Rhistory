smc_plot <- smc %>%
filter(x <= 100000) %>%
mutate(
time_kya = x / 1000
)
# ------------------------------------------------------------
# inspect plotted values
# ------------------------------------------------------------
cat(
'\nTime range in plotting data:',
min(smc_plot$time_kya),
'-',
max(smc_plot$time_kya),
'ka\n'
)
cat(
'Ne range:',
min(smc_plot$y),
'-',
max(smc_plot$y),
'\n\n'
)
# ------------------------------------------------------------
# plot
# ------------------------------------------------------------
p <- ggplot(
smc_plot,
aes(
x = time_kya,
y = y
)
) +
geom_line(
linewidth = 1.2,
color = '#6495ED',
lineend = 'round',
linejoin = 'round'
) +
scale_x_continuous(
breaks = c(
1,
20,
40,
60,
80,
100
),
expand = expansion(
mult = c(0, 0)
)
) +
scale_y_continuous(
breaks = breaks_pretty(
n = 6
),
labels = label_number(
scale = 1e-3,
accuracy = 1,
big.mark = ''
),
expand = expansion(
mult = c(0, 0.03)
)
) +
# crop visualization to 1-100 ka
# without deleting the x = 0 point from the data
coord_cartesian(
xlim = c(
1,
100
),
ylim = c(
0,
NA
),
expand = FALSE
) +
labs(
x = 'Years before present (Ka)',
y = expression(
'Effective population size (' *
N[e] *
' × 10'^3 *
')'
)
) +
theme_bw(
base_size = 14
) +
theme(
axis.title = element_text(
size = 16
),
axis.title.x = element_text(
margin = margin(
t = 15
)
),
axis.title.y = element_text(
margin = margin(
r = 15
)
),
axis.text = element_text(
size = 14,
color = 'black'
),
axis.line = element_line(
linewidth = 0.6,
color = 'black'
),
axis.ticks = element_line(
linewidth = 0.5,
color = 'black'
),
axis.ticks.length = unit(
0.15,
'cm'
),
panel.grid = element_blank(),
plot.margin = margin(
t = 10,
r = 15,
b = 10,
l = 10
)
)
# ------------------------------------------------------------
# show plot
# ------------------------------------------------------------
print(p)
# ------------------------------------------------------------
# clean workspace
# ------------------------------------------------------------
rm(list = ls(all.names = T))
gc()
# ------------------------------------------------------------
# load packages
# ------------------------------------------------------------
library(ggplot2)
library(dplyr)
library(scales)
# ------------------------------------------------------------
# read unrestricted SMC++ primary model
# ------------------------------------------------------------
smc <- read.csv(
'/home/yshin/Gloydius_ussuriensis_genome_assembly/outputs/demography/G_ussuriensis_mainland_primary.csv'
)
head(smc)
str(smc)
# ------------------------------------------------------------
# inspect recent demographic states
# ------------------------------------------------------------
cat('\nDistinct Ne values within 100 ka:\n')
print(
smc %>%
filter(x <= 100000) %>%
distinct(y)
)
cat('\nSMC++ values between 30 and 120 ka:\n')
print(
smc %>%
filter(x >= 30000, x <= 120000) %>%
select(x, y)
)
#
# x = 0 cannot be represented on a logarithmic axis.
# Since this figure starts at 1 ka, move ONLY the plotting
# position of the x = 0 endpoint to 1 ka.
#
# Its Ne value is unchanged.
#
# This preserves the inferred horizontal segment extending
# from the present to the next SMC++ time point (~20 ka).
# ------------------------------------------------------------
smc_plot <- smc %>%
filter(x <= 100000) %>%
mutate(
time_kya = ifelse(
x == 0,
1,
x / 1000
)
) %>%
filter(
time_kya >= 1,
time_kya <= 100
)
# ------------------------------------------------------------
# inspect plotted range
# ------------------------------------------------------------
cat(
'\nDisplayed time range:',
min(smc_plot$time_kya),
'-',
max(smc_plot$time_kya),
'ka\n'
)
cat(
'Displayed Ne range:',
min(smc_plot$y),
'-',
max(smc_plot$y),
'\n\n'
)
# ------------------------------------------------------------
# plot
# ------------------------------------------------------------
p <- ggplot(
smc_plot,
aes(
x = time_kya,
y = y
)
) +
geom_line(
linewidth = 1.2,
color = '#6495ED',
lineend = 'round',
linejoin = 'round'
) +
# logarithmic time axis
scale_x_log10(
breaks = c(
1,
2,
5,
10,
20,
50,
100
),
labels = c(
'1',
'2',
'5',
'10',
'20',
'50',
'100'
),
limits = c(
1,
100
),
expand = expansion(
mult = c(0, 0)
)
) +
# Ne shown in thousands
scale_y_continuous(
breaks = breaks_pretty(
n = 6
),
labels = label_number(
scale = 1e-3,
accuracy = 1,
big.mark = ''
),
limits = c(
0,
NA
),
expand = expansion(
mult = c(0, 0.03)
)
) +
labs(
x = 'Years before present (Ka)',
y = expression(
'Effective population size (' *
N[e] *
' × 10'^3 *
')'
)
) +
theme_bw(
base_size = 14
) +
theme(
axis.title = element_text(
size = 16
),
axis.title.x = element_text(
margin = margin(
t = 15
)
),
axis.title.y = element_text(
margin = margin(
r = 15
)
),
axis.text = element_text(
size = 14,
color = 'black'
),
axis.line = element_line(
linewidth = 0.6,
color = 'black'
),
axis.ticks = element_line(
linewidth = 0.5,
color = 'black'
),
axis.ticks.length = unit(
0.15,
'cm'
),
panel.grid = element_blank(),
plot.margin = margin(
t = 10,
r = 15,
b = 10,
l = 10
)
)
# ------------------------------------------------------------
# show plot
# ------------------------------------------------------------
print(p)
# ------------------------------------------------------------
# clean workspace
# ------------------------------------------------------------
rm(list = ls(all.names = T))
gc()
# ------------------------------------------------------------
# load packages
# ------------------------------------------------------------
library(ggplot2)
library(dplyr)
library(scales)
# ------------------------------------------------------------
# read unrestricted SMC++ primary model
# ------------------------------------------------------------
smc <- read.csv(
'/home/yshin/Gloydius_ussuriensis_genome_assembly/outputs/demography/G_ussuriensis_mainland_primary.csv'
)
head(smc)
str(smc)
#
# x = years before present
# y = effective population size (Ne)
#
# x = 0 cannot be shown on a logarithmic axis.
# Because the displayed figure begins at 1 ka,
# move only the plotting position of x = 0 to 1 ka.
#
# This does not alter the inferred Ne value.
# ------------------------------------------------------------
smc_plot <- smc %>%
filter(x <= 700000) %>%
mutate(
time_kya = ifelse(
x == 0,
1,
x / 1000
)
) %>%
filter(
time_kya >= 1,
time_kya <= 700
)
# ------------------------------------------------------------
# inspect plotted range
# ------------------------------------------------------------
cat(
'\nDisplayed time range:',
min(smc_plot$time_kya),
'-',
max(smc_plot$time_kya),
'ka\n'
)
cat(
'Displayed Ne range:',
min(smc_plot$y),
'-',
max(smc_plot$y),
'\n\n'
)
# ------------------------------------------------------------
# plot
# ------------------------------------------------------------
p <- ggplot(
smc_plot,
aes(
x = time_kya,
y = y
)
) +
geom_line(
linewidth = 1.2,
color = '#6495ED',
lineend = 'round',
linejoin = 'round'
) +
# logarithmic time axis
scale_x_log10(
breaks = c(
1,
2,
5,
10,
20,
50,
100,
200,
500,
700
),
labels = c(
'1',
'2',
'5',
'10',
'20',
'50',
'100',
'200',
'500',
'700'
),
limits = c(
1,
700
),
expand = expansion(
mult = c(0, 0)
)
) +
# Ne shown in thousands
scale_y_continuous(
breaks = breaks_pretty(
n = 6
),
labels = label_number(
scale = 1e-3,
accuracy = 1,
big.mark = ''
),
limits = c(
0,
NA
),
expand = expansion(
mult = c(0, 0.03)
)
) +
labs(
x = 'Years before present (Ka)',
y = expression(
'Effective population size (' *
N[e] *
' × 10'^3 *
')'
)
) +
theme_bw(
base_size = 14
) +
theme(
axis.title = element_text(
size = 16
),
axis.title.x = element_text(
margin = margin(
t = 15
)
),
axis.title.y = element_text(
margin = margin(
r = 15
)
),
axis.text = element_text(
size = 14,
color = 'black'
),
axis.line = element_line(
linewidth = 0.6,
color = 'black'
),
axis.ticks = element_line(
linewidth = 0.5,
color = 'black'
),
axis.ticks.length = unit(
0.15,
'cm'
),
panel.grid = element_blank(),
plot.margin = margin(
t = 10,
r = 15,
b = 10,
l = 10
)
)
# ------------------------------------------------------------
# show plot
# ------------------------------------------------------------
print(p)
rm(list = ls(all.names = T))
gc()

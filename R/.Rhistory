draw_plot(plot_landscape, x = 0.035, y = 0.055, width = 0.595, height = 0.855) +
draw_plot(plot_pie, x = 0.095, y = 0.500, width = 0.230, height = 0.410) +
draw_label('TE Classification', x = 0.660, y = 0.800, hjust = 0, fontface = 'bold', size = 14)

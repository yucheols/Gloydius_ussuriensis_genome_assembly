color = 'steelblue3',
linewidth = 0.25,
alpha = 0.18,
direction = 'hv') +
geom_step(data = primary_plot,
aes(x = years,
y = Ne),
color = 'steelblue4',
linewidth = 1.2,
direction = 'hv') +
scale_x_log10(limits = c(plot_min_year, plot_max_year),
breaks = c(2e4, 5e4, 1e5, 2e5, 5e5, 1e6, 2e6),
labels = c('20K', '50K', '100K', '200K', '500K', '1M', '2M')) +
scale_y_continuous(limits = c(0, NA),
labels = label_comma(),
expand = expansion(mult = c(0, 0.03))) +
labs(x = 'Years before present',
y = expression(Effective~population~size~italic(N)[e])) +
theme_classic(base_size = 14) +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 13),
axis.line = element_line(linewidth = 0.7),
axis.ticks = element_line(linewidth = 0.7),
plot.margin = margin(10, 15, 10, 10))
print(p)
